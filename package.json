{
  "name": "repo1",
  "version": "1.0.0",
  "description": "",
  "main": "caso-de-prueba1.js",
  "scripts": {
    "limpiar-reporte": "rimraf ./allure-report && rimraf ./allure-results",
    "abrir-reporte": "allure open",
    "ejecutar-pruebas": "npx cypress run --env allure=true --headed",
    "generar-reporte": "allure generate allure-results -o allure-report --clean",
    "test": "npm run limpiar-reporte && npm run ejecutar-pruebas && npm run generar-reporte && npm run abrir-reporte",
    "cy:parallel": "npm run limpiar-reporte && cypress-parallel -s ejecutar-pruebas -t 2 -d ./cypress/e2e/test; generar-reporte"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "cypress": "^14.3.2",
    "cypress-parallel": "^0.15.0"
  },
  "dependencies": {
    "@mmisty/cypress-allure-adapter": "^3.2.3",
    "@shelex/cypress-allure-plugin": "^2.41.1",
    "allure-commandline": "^2.34.0",
    "rimraf": "^6.0.1"
  }
}
